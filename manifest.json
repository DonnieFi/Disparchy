{
  "schemaVersion": 1,
  "id": "dkfiander.disparchy",
  "name": "Disparchy",
  "version": "0.6.0",
  "author": "Donnie Fiander",
  "license": "MIT",
  "description": "Comparison panel: one prompt, selected providers, parallel local AI answers.",
  "homepage": "https://github.com/DonnieFi/Disparchy",
  "repository": "https://github.com/DonnieFi/Disparchy",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Disparchy",
    "description": "One prompt, parallel providers, side-by-side AI answers.",
    "category": "AI",
    "aliases": [
      "disparchy",
      "dispatch",
      "mux",
      "ask"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "timeoutSec": 90,
      "historyMaxRuns": 50,
      "modelClaude": "sonnet",
      "modelCodex": "",
      "modelGrok": "",
      "modelAntigravity": "",
      "modelCursor": ""
    },
    "schema": [
      {
        "key": "timeoutSec",
        "type": "integer",
        "label": "Per-target timeout (seconds)",
        "min": 15,
        "max": 300,
        "step": 15,
        "defaultValue": 90
      },
      {
        "key": "historyMaxRuns",
        "type": "integer",
        "label": "History cap (runs)",
        "min": 10,
        "max": 200,
        "step": 10,
        "defaultValue": 50
      },
      {
        "key": "modelClaude",
        "type": "string",
        "label": "Default Claude model",
        "defaultValue": "sonnet"
      },
      {
        "key": "modelCodex",
        "type": "string",
        "label": "Default Codex model (empty = CLI default)",
        "defaultValue": ""
      },
      {
        "key": "modelGrok",
        "type": "string",
        "label": "Default Grok model (empty = CLI default)",
        "defaultValue": ""
      },
      {
        "key": "modelAntigravity",
        "type": "string",
        "label": "Default Antigravity model (empty = CLI default)",
        "defaultValue": ""
      },
      {
        "key": "modelCursor",
        "type": "string",
        "label": "Default Cursor model (empty = CLI default)",
        "defaultValue": ""
      }
    ]
  }
}
