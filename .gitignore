# Agent instruction files must not ship: omarchy plugin add clones this
# tree into ~/.config/omarchy/plugins/, and coding agents treat those
# filenames as trusted workspace policy.
AGENT_PROMPT.md
AGENTS.md
CLAUDE.md
.agents/
.claude/
.codex/
.cursor/
.grok/

# Dotfiles / agent tooling — machine-local
.*
!.gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
venv/

# OS
Thumbs.db

# Secrets and scratch
*.pem
*.key
*.p12
*.log
*.tmp
*.swp
*~
scratch/

# Per-user plugin state; normally kept outside this repository.
auth.json
selection.json
history.json
prompt.txt
status.json

# Screenshots can capture local endpoints, prompts, or provider sign-in state.
# Allow only the reviewed blank Ask view in the public README.
docs/screenshots/*
!docs/screenshots/ask-0.4.0.png

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
