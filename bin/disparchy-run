#!/usr/bin/env python3
"""One-shot runner for Disparchy. Only this program reads and writes API keys.

Keys live in $XDG_STATE_HOME/omarchy/dkfiander.disparchy/auth.json
(default ~/.local/state/omarchy/dkfiander.disparchy/auth.json).
--set-key reads the key from stdin until EOF, never from argv or the
environment. The state directory is created at mode 0700. auth.json is
replaced by a temp file in that same directory, opened O_CREAT|O_EXCL
at mode 0600, fsynced, then renamed into place. A symlink or a
non-regular state directory or auth.json is refused and nothing is
written. --set-key accepts an existing regular auth.json owned by the
current user even when the mode is loose, and the rewrite lands at
mode 0600. A file owned by another user is refused. Reading a key
still refuses a loose auth.json. --status prints key:none, key:saved,
key:refused, or key:unusable and never any part of a key. key:refused
is only a regular file you own whose JSON is a dict and whose mode is
loose. Everything else that is not a missing or readable file is
key:unusable, and that column cannot crash --status.
No shell interpolation."""
from __future__ import annotations

import argparse
import http.client
import json
import os
import shutil
import socket
import stat
import subprocess
import sys
import time
from typing import NamedTuple
import urllib.error
import urllib.request
from pathlib import Path

CLI_ALLOWED = (
    "claude",
    "codex",
    "grok",
    "antigravity",
    "cursor",
    "openclaw",
    "hermes",
)
HTTP_ALLOWED = ("ollama", "lmstudio")
ALLOWED = CLI_ALLOWED + HTTP_ALLOWED

DEFAULT_ENDPOINT = {
    "ollama": "http://127.0.0.1:11434",
    "lmstudio": "http://127.0.0.1:1234",
    "openclaw": "http://127.0.0.1:18789",
    "hermes": "http://127.0.0.1:8642",
}
CHAT_HTTP = ("openclaw", "hermes")
MAX_RESPONSE_BYTES = 8 * 1024 * 1024
MAX_MODELS_BYTES = 1024 * 1024
MAX_ERROR_BYTES = 300
DEFAULT_CHAT_MODEL = {
    "openclaw": "openclaw/default",
    "hermes": "hermes-agent",
}

BIN = {
    "claude": ("claude",),
    "codex": ("codex",),
    "grok": ("grok",),
    "antigravity": ("agy",),
    "cursor": ("cursor-agent", "agent"),
    "openclaw": ("openclaw",),
    "hermes": ("hermes",),
}


def resolve(cli: str) -> str | None:
    names = BIN.get(cli)
    if not names:
        return None
    for name in names:
        path = shutil.which(name)
        if path:
            return path
    return None


def auth_label(cli: str, binary: str) -> str:
    try:
        if cli == "claude":
            proc = subprocess.run(
                [binary, "auth", "status"],
                capture_output=True,
                text=True,
                timeout=4,
            )
            body = proc.stdout or ""
            if '"loggedIn": true' in body or '"loggedIn":true' in body:
                return "signed-in"
            return "signed-out"
        if cli == "codex":
            proc = subprocess.run(
                [binary, "login", "status"],
                capture_output=True,
                text=True,
                timeout=4,
            )
            if "Logged in" in (proc.stdout or ""):
                return "signed-in"
            return "signed-out"
        if cli == "cursor":
            proc = subprocess.run(
                [binary, "status"],
                capture_output=True,
                text=True,
                timeout=4,
            )
            if "Logged in" in (proc.stdout or ""):
                return "signed-in"
            return "signed-out"
        if cli == "gemini":
            proc = subprocess.run(
                [binary, "auth", "status"],
                capture_output=True,
                text=True,
                timeout=4,
            )
            blob = (proc.stdout or "") + (proc.stderr or "")
            if "Please set an Auth" in blob or "GEMINI_API_KEY" in blob:
                return "signed-out"
            return "signed-in" if proc.returncode == 0 else "unknown"
        if cli == "grok":
            auth = Path.home() / ".grok" / "auth.json"
            if auth.is_file() and auth.stat().st_size > 2:
                return "signed-in"
            return "signed-out"
    except (subprocess.TimeoutExpired, OSError):
        return "unknown"
    return "unknown"


def codexbar_hints() -> dict[str, str]:
    binary = shutil.which("codexbar")
    if not binary:
        return {}
    try:
        proc = subprocess.run(
            [binary, "usage", "--json", "--no-color", "--source", "cli", "--provider", "all"],
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (subprocess.TimeoutExpired, OSError):
        return {}
    if proc.returncode != 0 or not (proc.stdout or "").strip():
        return {}
    try:
        import json
        payload = json.loads(proc.stdout)
    except Exception:
        return {}
    rows = payload if isinstance(payload, list) else payload.get("providers") if isinstance(payload, dict) else None
    if not isinstance(rows, list):
        return {}
    hints: dict[str, str] = {}
    alias = {"claude": "claude", "codex": "codex", "gemini": "gemini", "cursor": "cursor", "grok": "grok", "xai": "grok"}
    for row in rows:
        if not isinstance(row, dict):
            continue
        key = alias.get(str(row.get("provider") or row.get("id") or "").lower(), "")
        if not key:
            continue
        err = row.get("error")
        blob = err if isinstance(err, str) else str(err or "")
        if "auth" in blob.lower() or "unauthorized" in blob.lower():
            hints[key] = "signed-out"
        elif row.get("accountEmail") or row.get("account"):
            hints[key] = "signed-in"
    return hints


def endpoint_or_default(cli: str, endpoint: str) -> str:
    text = (endpoint or "").strip()
    return text or DEFAULT_ENDPOINT.get(cli, "")


class ResponseError(Exception):
    pass


def read_json_capped(resp, limit: int) -> dict:
    declared = resp.headers.get("Content-Length", "")
    if declared.isdigit() and int(declared) > limit:
        raise ResponseError(f"response larger than {limit} bytes")
    try:
        raw = resp.read(limit + 1)
    except http.client.IncompleteRead as exc:
        raise ResponseError("response truncated") from exc
    if len(raw) > limit:
        raise ResponseError(f"response larger than {limit} bytes")
    # http.client returns a short read without raising when the peer
    # closes before Content-Length; the unread remainder stays in .length.
    if getattr(resp, "length", None):
        raise ResponseError("response truncated")
    try:
        payload = json.loads(raw.decode() or "{}")
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ResponseError("response is not valid JSON") from exc
    if not isinstance(payload, dict):
        raise ResponseError("response is not a JSON object")
    return payload


def http_complete(cli: str, endpoint: str, model: str, prompt: str, timeout: int) -> str:
    base = endpoint_or_default(cli, endpoint).rstrip("/")
    if not base:
        raise SystemExit("missing endpoint")
    if cli == "ollama":
        url = base + "/api/generate"
        body = {"model": (model or "llama3.2").strip(), "prompt": prompt, "stream": False}
    else:
        url = base + "/v1/chat/completions"
        body = {
            "model": (model or "local").strip(),
            "messages": [{"role": "user", "content": prompt}],
        }
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = read_json_capped(resp, MAX_RESPONSE_BYTES)
    except urllib.error.URLError as exc:
        raise SystemExit(str(exc.reason or exc)) from exc
    except ResponseError as exc:
        raise SystemExit(str(exc)) from exc
    if cli == "ollama":
        return str(payload.get("response") or "")
    choices = payload.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return str(message.get("content") or "")


def chat_request(
    cli: str,
    endpoint: str,
    model: str,
    prompt: str,
    bearer: str,
) -> tuple[str, dict, dict[str, str]]:
    base = endpoint_or_default(cli, endpoint).rstrip("/")
    chosen = (model or "").strip() or DEFAULT_CHAT_MODEL.get(cli, "")
    url = base + "/v1/chat/completions"
    body = {
        "model": chosen,
        "messages": [{"role": "user", "content": prompt}],
    }
    headers = {"Content-Type": "application/json"}
    token = (bearer or "").strip()
    if token:
        headers["Authorization"] = "Bearer " + token
    return url, body, headers


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME", "").strip()
    if base:
        root = Path(base)
    else:
        root = Path.home() / ".local" / "state"
    return root / "omarchy" / "dkfiander.disparchy"


def auth_path() -> Path:
    return state_dir() / "auth.json"


def ensure_state_dir() -> Path:
    path = state_dir()
    if path.is_symlink():
        raise SystemExit("state dir refused")
    if path.exists():
        if not path.is_dir():
            raise SystemExit("state dir refused")
        return path
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        if path.is_symlink() or not path.is_dir():
            raise SystemExit("state dir refused")
    return path


def normalize_key(raw: str) -> str:
    text = raw if isinstance(raw, str) else ""
    if text.endswith("\n"):
        text = text[:-1]
    if text.endswith("\r"):
        text = text[:-1]
    return text


class AuthFile(NamedTuple):
    state: str
    payload: dict | None
    message: str


def lstat_auth_file(path: Path) -> os.stat_result:
    """Identity check shared by set_key and the strict read.

    lstat never follows a symlink. A symlink, anything that is not a
    regular file, another owner, or an OSError on the file is refused.
    """
    try:
        info = os.lstat(path)
    except FileNotFoundError as exc:
        raise SystemExit("auth file refused") from exc
    except OSError as exc:
        raise SystemExit("auth file refused") from exc
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise SystemExit("auth file refused")
    if info.st_uid != os.getuid():
        raise SystemExit("auth file refused")
    return info


def auth_file_state(path: Path) -> AuthFile:
    """Classify auth.json without raising.

    missing: lstat raises FileNotFoundError.
    ok: lstat_auth_file passes, the JSON is a dict, and the mode is 0600-class.
    refused: that same file, and the only fault is group or other mode bits.
    unusable: symlink, another owner, a non-regular file, broken or
    non-dict JSON, or any OSError reading the file or its directory.
    """
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return AuthFile("missing", None, "auth file refused")
    except OSError:
        return AuthFile("unusable", None, "auth file refused")
    try:
        info = lstat_auth_file(path)
    except SystemExit as exc:
        return AuthFile("unusable", None, str(exc) or "auth file refused")
    loose = bool(info.st_mode & 0o077)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return AuthFile("unusable", None, "auth file unreadable")
    if not isinstance(payload, dict):
        return AuthFile("unusable", None, "auth file unreadable")
    if loose:
        return AuthFile("refused", payload, "auth file must be mode 600")
    return AuthFile("ok", payload, "")


def load_auth(path: Path) -> dict:
    found = auth_file_state(path)
    if found.state != "ok" or found.payload is None:
        raise SystemExit(found.message or "auth file refused")
    return found.payload


def atomic_write_auth(directory: Path, payload: dict) -> None:
    data = (json.dumps(payload, indent=2) + "\n").encode("utf-8")
    tmp = directory / f".auth-{os.getpid()}-{time.time_ns()}.tmp"
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.write(fd, data)
        os.fsync(fd)
    except Exception:
        os.close(fd)
        tmp.unlink(missing_ok=True)
        raise
    os.close(fd)
    try:
        os.replace(tmp, directory / "auth.json")
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def set_key(cli: str, raw: str) -> None:
    if cli not in CHAT_HTTP:
        raise SystemExit("unknown cli")
    directory = ensure_state_dir()
    target = directory / "auth.json"
    payload: dict = {}
    # Accept a missing file, or a regular file this user owns whose JSON
    # is a dict, including a loose mode. Never rewrite an unusable file.
    if target.is_symlink() or target.exists():
        found = auth_file_state(target)
        if found.state not in ("ok", "refused") or found.payload is None:
            raise SystemExit(found.message or "auth file refused")
        payload = found.payload
    text = normalize_key(raw)
    if text == "":
        payload.pop(cli, None)
    else:
        payload[cli] = text
    atomic_write_auth(directory, payload)


def read_bearer(cli: str) -> str:
    if cli not in CHAT_HTTP:
        return ""
    found = auth_file_state(auth_path())
    if found.state == "missing":
        return ""
    if found.state != "ok" or found.payload is None:
        raise SystemExit(found.message or "auth file refused")
    key = found.payload.get(cli)
    if not isinstance(key, str):
        return ""
    return key.strip()


def key_column(cli: str) -> str:
    if cli not in CHAT_HTTP:
        return "key:none"
    try:
        found = auth_file_state(auth_path())
    except Exception:
        return "key:unusable"
    if found.state == "missing":
        return "key:none"
    if found.state == "unusable":
        return "key:unusable"
    if found.state == "refused":
        return "key:refused"
    key = (found.payload or {}).get(cli)
    if isinstance(key, str) and key.strip():
        return "key:saved"
    return "key:none"


def chat_complete(
    cli: str,
    endpoint: str,
    model: str,
    prompt: str,
    timeout: int,
    bearer: str,
) -> str:
    url, body, headers = chat_request(cli, endpoint, model, prompt, bearer)
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = read_json_capped(resp, MAX_RESPONSE_BYTES)
    except urllib.error.HTTPError as exc:
        detail = exc.read(MAX_ERROR_BYTES).decode(errors="replace")
        raise SystemExit(f"HTTP {exc.code} {detail}") from exc
    except urllib.error.URLError as exc:
        raise SystemExit(str(exc.reason or exc)) from exc
    except ResponseError as exc:
        raise SystemExit(str(exc)) from exc
    choices = payload.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return str(message.get("content") or "")


def http_auth(cli: str, endpoint: str) -> str:
    base = endpoint_or_default(cli, endpoint).rstrip("/")
    path = "/api/tags" if cli == "ollama" else "/v1/models"
    try:
        with urllib.request.urlopen(base + path, timeout=1.5) as resp:
            return "signed-in" if resp.status == 200 else "signed-out"
    except Exception:
        return "signed-out"


def gateway_up(port: int = 18789) -> bool:
    sock = socket.socket()
    sock.settimeout(0.4)
    try:
        sock.connect(("127.0.0.1", port))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def emit_model(cli: str, value: str, label: str) -> None:
    text = (value or "").strip()
    if not text:
        return
    print(f"{cli}\t{text}\t{(label or text).strip()}")


def parse_codex_models(raw: str) -> list[tuple[str, str]]:
    try:
        data = json.loads(raw or "{}")
    except json.JSONDecodeError:
        return []
    out: list[tuple[str, str]] = []
    for row in data.get("models") or []:
        if not isinstance(row, dict):
            continue
        if row.get("visibility") == "hidden":
            continue
        slug = str(row.get("slug") or "").strip()
        if slug:
            out.append((slug, str(row.get("display_name") or slug)))
    return out


def parse_dash_models(raw: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    for line in (raw or "").splitlines():
        text = line.strip()
        if " - " not in text:
            continue
        value, label = text.split(" - ", 1)
        value = value.strip()
        if value:
            out.append((value, label.strip() or value))
    return out


def parse_grok_models(raw: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    for line in (raw or "").splitlines():
        text = line.strip().lstrip("*").lstrip("-").strip()
        if not text or text.startswith("You are") or text.startswith("Default") or text.startswith("Available"):
            continue
        name = text.replace("(default)", "").strip()
        if name and " " not in name:
            out.append((name, name))
    return out


def parse_tab_models(raw: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    for line in (raw or "").splitlines():
        if "\t" not in line or line.startswith("Fetch"):
            continue
        value, label = line.split("\t", 1)
        value = value.strip()
        if value:
            out.append((value, label.strip() or value))
    return out


def print_models() -> None:
    probes = (
        ("codex", ["codex", "debug", "models"], parse_codex_models),
        ("grok", ["grok", "models"], parse_grok_models),
        ("cursor", ["cursor-agent", "models"], parse_dash_models),
        ("antigravity", ["agy", "models"], parse_tab_models),
    )
    for cli, cmd, parser in probes:
        binary = resolve(cli) if cli != "cursor" else (resolve("cursor") or shutil.which("cursor-agent"))
        if cli != "cursor" and not binary:
            continue
        argv = cmd if cli != "cursor" else [binary or "cursor-agent", "models"]
        if cli != "cursor":
            argv = [binary, *cmd[1:]]
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=6)
        except (subprocess.TimeoutExpired, OSError):
            continue
        rows = parser(proc.stdout or "")[:30]
        for value, label in rows:
            emit_model(cli, value, label)
    claw = resolve("openclaw")
    if claw:
        try:
            proc = subprocess.run(
                [claw, "models", "list", "--json"],
                capture_output=True,
                text=True,
                timeout=6,
            )
            payload = json.loads(proc.stdout or "{}")
        except (subprocess.TimeoutExpired, OSError, json.JSONDecodeError):
            payload = {}
        for row in (payload.get("models") or [])[:30]:
            if isinstance(row, str):
                emit_model("openclaw", row, row)
            elif isinstance(row, dict):
                value = str(row.get("id") or row.get("name") or "").strip()
                emit_model("openclaw", value, str(row.get("name") or value))
    for cli in HTTP_ALLOWED:
        base = endpoint_or_default(cli, "").rstrip("/")
        path = "/api/tags" if cli == "ollama" else "/v1/models"
        try:
            with urllib.request.urlopen(base + path, timeout=1.5) as resp:
                payload = read_json_capped(resp, MAX_MODELS_BYTES)
        except Exception:
            continue
        if cli == "ollama":
            for row in (payload.get("models") or [])[:30]:
                if isinstance(row, dict):
                    emit_model(cli, str(row.get("name") or ""), str(row.get("name") or ""))
        else:
            for row in (payload.get("data") or [])[:30]:
                if isinstance(row, dict):
                    emit_model(cli, str(row.get("id") or ""), str(row.get("id") or ""))


def print_status() -> None:
    hints = codexbar_hints()
    for cli in CLI_ALLOWED:
        binary = resolve(cli)
        if cli == "openclaw" and binary:
            mode = "gateway" if gateway_up() else "local node"
            print(f"{cli}\tinstalled\t{mode}\t{key_column(cli)}")
            continue
        key = key_column(cli)
        if not binary:
            print(f"{cli}\tmissing\t\t{key}")
            continue
        label = auth_label(cli, binary)
        hint = hints.get(cli, "")
        if hint == "signed-out" and label != "signed-in":
            label = "signed-out"
        elif label in ("unknown", "") and hint:
            label = hint
        print(f"{cli}\tinstalled\t{label}\t{key}")
    for cli in HTTP_ALLOWED:
        label = http_auth(cli, "")
        installed = "installed" if label == "signed-in" else "missing"
        print(f"{cli}\t{installed}\t{label}\t{key_column(cli)}")


def argv_for(
    cli: str,
    binary: str,
    model: str,
    prompt: str,
    prompt_file: str | None = None,
    via_gateway: bool = False,
) -> list[str]:
    m = (model or "").strip()
    if cli == "claude":
        cmd = [binary, "-p", "--output-format", "text"]
        if m:
            cmd += ["--model", m]
        cmd += ["--", prompt]
        return cmd
    if cli == "codex":
        cmd = [binary, "exec", "--skip-git-repo-check"]
        if m:
            cmd += ["--model", m]
        cmd += ["--", prompt]
        return cmd
    if cli == "grok":
        cmd = [binary, "--no-auto-update", "-p", prompt]
        if m:
            cmd += ["--model", m]
        cmd += ["--output-format", "plain"]
        return cmd
    if cli == "antigravity":
        cmd = [binary, "--output-format", "text"]
        if m:
            cmd += ["--model", m]
        cmd += ["--print", prompt]
        return cmd
    if cli == "cursor":
        cmd = [binary, "-p", "--output-format", "text"]
        if m:
            cmd += ["--model", m]
        cmd += ["--", prompt]
        return cmd
    if cli == "openclaw":
        src = prompt_file or prompt
        if via_gateway:
            cmd = [binary, "agent", "--message-file", src]
        else:
            cmd = [binary, "agent", "exec", "--message-file", src]
        if m:
            cmd += ["--model", m]
        return cmd
    if cli == "hermes":
        cmd = [binary, "chat", "--oneshot", "--query-file", prompt_file or prompt]
        if m:
            cmd += ["-m", m]
        return cmd
    raise SystemExit(f"unknown cli: {cli}")


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("--cli", choices=ALLOWED)
    p.add_argument("--model", default="")
    p.add_argument("--timeout", type=int, default=90)
    p.add_argument("--prompt-file")
    p.add_argument("--endpoint", default="")
    p.add_argument(
        "--set-key",
        choices=CHAT_HTTP,
        help="Read one API key from stdin until EOF and store it. Empty stdin removes it.",
    )
    p.add_argument(
        "--discover",
        action="store_true",
        help="Print CLIs whose binaries are on PATH, one per line.",
    )
    p.add_argument(
        "--status",
        action="store_true",
        help="Print cli, installed|missing, auth label, key:saved|key:none. Does not print API keys.",
    )
    p.add_argument(
        "--models",
        action="store_true",
        help="Print cli, model id, label from each provider. Does not print API keys.",
    )
    args = p.parse_args()

    if args.set_key:
        set_key(args.set_key, sys.stdin.read())
        return 0

    if args.discover:
        for cli in CLI_ALLOWED:
            if resolve(cli):
                print(cli)
        for cli in HTTP_ALLOWED:
            if http_auth(cli, "") == "signed-in":
                print(cli)
        return 0

    if args.status:
        print_status()
        return 0

    if args.models:
        print_models()
        return 0

    if not args.cli or not args.prompt_file:
        p.error("--cli and --prompt-file are required unless --discover, --status, or --set-key")

    prompt = open(args.prompt_file, encoding="utf-8").read()
    if len(prompt.encode()) > 32 * 1024:
        print("prompt too large (32KiB cap)", file=sys.stderr)
        return 3

    if args.cli in CHAT_HTTP:
        bearer = read_bearer(args.cli)
        if bearer:
            text = chat_complete(
                args.cli,
                args.endpoint,
                args.model,
                prompt,
                args.timeout,
                bearer,
            )
            sys.stdout.write(text)
            return 0

    if args.cli in HTTP_ALLOWED:
        text = http_complete(args.cli, args.endpoint, args.model, prompt, args.timeout)
        sys.stdout.write(text)
        return 0

    binary = resolve(args.cli)
    if not binary:
        print(f"missing:{args.cli}", file=sys.stderr)
        return 2

    via_gateway = args.cli == "openclaw" and gateway_up()
    cmd = argv_for(args.cli, binary, args.model, prompt, args.prompt_file, via_gateway)
    env = os.environ.copy()
    env["TERM"] = "dumb"
    started = time.monotonic()
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            stdin=subprocess.DEVNULL,
            timeout=args.timeout,
            cwd=os.path.expanduser("~"),
            env=env,
        )
    except subprocess.TimeoutExpired:
        print("timeout", file=sys.stderr)
        return 124

    out = proc.stdout or ""
    err = proc.stderr or ""
    if len(out) > 256 * 1024:
        out = out[: 256 * 1024] + "\n[truncated]"
    sys.stdout.write(out)
    if proc.returncode != 0:
        sys.stderr.write(err[: 16 * 1024])
        return proc.returncode
    _ = started
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
